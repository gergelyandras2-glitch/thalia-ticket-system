        <!-- 13: Redirect and render confirmation -->
        <mxCell id="m13" value="13: Redirect to /bookings/confirm?code=... (Render E-Ticket)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#1D4ED8;" edge="1" parent="1" source="ll_ctrl" target="ll_user">
          <mxGeometry y="10" relative="1" as="geometry">
